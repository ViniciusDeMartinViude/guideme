TELEGRAM_BOT_TOKEN=
# Model provider: gemini (default) or openrouter
BOT_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Optional: restrict the bot to these chat ids (comma-separated). Empty = any chat it is added to.
ALLOWED_CHAT_IDS=
# Model id; empty = provider default (gemini-3.8-flash / anthropic/claude-opus-5)
BOT_MODEL=
BOT_EFFORT=medium
DB_PATH=./data/bot.sqlite

# Webhook mode: public https base URL (e.g. the ngrok tunnel). Then `npm run webhook:set`.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Basic-auth password for the dashboard (username is ignored). Empty = no auth.
DASHBOARD_PASSWORD=
